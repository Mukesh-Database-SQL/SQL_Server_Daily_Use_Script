SELECT 
    r.session_id AS [SPID],
    r.status AS [Status],
    CONVERT(VARCHAR(20), DATEADD(ms, r.total_elapsed_time, 0), 114) AS [Duration_HH_MM_SS],
    r.cpu_time AS [CPU_Time_ms],
    r.logical_reads AS [Logical_Reads],
    r.blocking_session_id AS [Blocked_By],
    SUBSTRING(st.text, (r.statement_start_offset/2)+1,   
        ((CASE r.statement_end_offset   
            WHEN -1 THEN DATALENGTH(st.text)  
            ELSE r.statement_end_offset END   
        - r.statement_start_offset)/2) + 1) AS [Active_Statement],
    st.text AS [Full_Batch_Text]
FROM sys.dm_exec_requests r
CROSS APPLY sys.dm_exec_sql_text(r.sql_handle) st
WHERE r.session_id > 50 
  AND r.session_id <> @@SPID
ORDER BY r.total_elapsed_time DESC;




SELECT 
    r.session_id AS [SPID],
    r.status,
    r.start_time,
    CONVERT(VARCHAR(20), DATEADD(ms, r.total_elapsed_time, 0), 114) AS [Duration],
    r.cpu_time AS [CPU],
    r.logical_reads AS [Reads],
    r.blocking_session_id AS [Blocked By],
    t.text AS [SQL Statement]
FROM sys.dm_exec_requests r
CROSS APPLY sys.dm_exec_sql_text(r.sql_handle) t
WHERE r.session_id > 50 -- Filters out internal system SPIDs
ORDER BY r.total_elapsed_time DESC;


SELECT 
    r.session_id,
    s.login_name,
    s.host_name,
    DB_NAME(r.database_id) AS database_name,
    r.start_time,
    r.status,
    -- Converts total elapsed time from milliseconds to minutes
    (r.total_elapsed_time / 1000) / 60 AS elapsed_minutes,
    st.text AS query_text
FROM sys.dm_exec_requests r
INNER JOIN sys.dm_exec_sessions s ON r.session_id = s.session_id
CROSS APPLY sys.dm_exec_sql_text(r.sql_handle) st
WHERE r.total_elapsed_time > 5000 -- Time in milliseconds (e.g., 5 seconds)
ORDER BY r.total_elapsed_time DESC;
